---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Sidebar from "~/components/Sidebar.astro";
import { sidebar } from "~/data/site";
import { hero } from "~/data/hero";
import { shippedRows } from "~/data/shipped";
import { siteAssetUrl } from "~/lib/siteAssetUrl";

// Use Indigo (2 external links + 10 press items) — the most complex row, which
// is where the right-rail problems show up most clearly.
const indigo = shippedRows.find((r) => /Indigo/.test(r.titleHtml)) ?? shippedRows[1];
const { thumbPath, thumbAlt, titleHtml, meta, note, links = [], press = [] } = indigo;
const thumbSrc = siteAssetUrl(thumbPath, "270");

// Dev-only mockup page; never ship it to the live site.
if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}
---
<BaseLayout title="Work-row mockups" path="/mockups/work-rows">
  <Sidebar
    name={sidebar.name}
    role={sidebar.role}
    frames={hero.frames}
    chips={[...sidebar.chips]}
    navItems={[...sidebar.navItems]}
    socials={[...sidebar.socials]}
  />
  <main class="main mockup-main" id="main">
    <section class="section"><div class="container">
    <header class="mockup-header">
      <p class="mockup-eyebrow">Mockup · work-row link treatments</p>
      <h1 class="mockup-h1">Right-column link options</h1>
      <p class="mockup-lede">
        Six variants, same data (Project Indigo), rendered inside the real site
        column (.section &gt; .container) so widths match the live page exactly.
        V0–V4 keep the 88px / 1fr / 140px grid; V5–V6 drop the right column and
        place actions below.
      </p>
    </header>

    {/* ——————————————————————————————————— V0: current (baseline) */}
    <section class="variant">
      <h2 class="variant-title">V0 · Current (baseline)</h2>
      <p class="variant-note">For reference. Per-link underline; PRESS bottom-aligned in col 3.</p>
      <article class="mock row-v0">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
        </div>
        <div class="links">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
        <div class="press-summary">
          <span class="press-label">Press</span>
          <span class="press-count">({press.length})</span>
          <span class="chevron">↓</span>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V1: quiet stack + arrows */}
    <section class="variant">
      <h2 class="variant-title">V1 · Quiet stack + arrows</h2>
      <p class="variant-note">Drop underlines. Top-aligned stack including Press. External links → ↗, press → ▾. Treats every right-column item the same.</p>
      <article class="mock row-v1">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
        </div>
        <div class="actions">
          {links.map((l) => (
            <a class="action" href={l.href}>
              <span>{l.label}</span><span class="arr">↗</span>
            </a>
          ))}
          <button class="action action--press" type="button">
            <span>Press ({press.length})</span><span class="arr">▾</span>
          </button>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V2: horizontal action bar below note */}
    <section class="variant">
      <h2 class="variant-title">V2 · Action bar below note</h2>
      <p class="variant-note">Kill the right rail. One horizontal action row beneath the note — primary links left, press disclosure right. Body uses cols 2–3.</p>
      <article class="mock row-v2">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
          <div class="action-bar">
            <div class="action-bar-left">
              {links.map((l, i) => (
                <>
                  {i > 0 && <span class="sep">·</span>}
                  <a class="action" href={l.href}>
                    <span>{l.label}</span><span class="arr">↗</span>
                  </a>
                </>
              ))}
            </div>
            <button class="action action--press" type="button">
              <span>Press ({press.length})</span><span class="arr">▾</span>
            </button>
          </div>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V3: outlined chips */}
    <section class="variant">
      <h2 class="variant-title">V3 · Outlined chips</h2>
      <p class="variant-note">Sans-serif chips on the right. Reads more like product UI than editorial — louder, but each action is unmistakably tappable.</p>
      <article class="mock row-v3">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
        </div>
        <div class="chips">
          {links.map((l) => (
            <a class="chip" href={l.href}>
              <span>{l.label}</span><span class="arr">↗</span>
            </a>
          ))}
          <button class="chip chip--press" type="button">
            <span>Press</span><span class="chip-count">{press.length}</span><span class="arr">▾</span>
          </button>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V4: title is primary link */}
    <section class="variant">
      <h2 class="variant-title">V4 · Title is the primary link</h2>
      <p class="variant-note">Promote canonical link into the title (h3 → a, ↗). Right column shrinks to secondary actions + press only. Strongest hierarchy.</p>
      <article class="mock row-v4">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title">
            <a href={links[0]?.href}>
              <span set:html={titleHtml}/><span class="title-arr"> ↗</span>
            </a>
          </h3>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
        </div>
        <div class="actions">
          {links.slice(1).map((l) => (
            <a class="action" href={l.href}>
              <span>{l.label}</span><span class="arr">↗</span>
            </a>
          ))}
          <button class="action action--press" type="button">
            <span>Press ({press.length})</span><span class="arr">▾</span>
          </button>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V5: full-width content, buttons underneath */}
    <section class="variant">
      <h2 class="variant-title">V5 · Full-width content, buttons underneath</h2>
      <p class="variant-note">Drop the right column. Body spans the rest of the row at the site's normal content width (60ch reading cap on the note stays); actions sit on their own footer-bar below.</p>
      <article class="mock row-v5">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
        </div>
        <div class="footer-bar">
          <div class="footer-bar-left">
            {links.map((l, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                <a class="action" href={l.href}>
                  <span>{l.label}</span><span class="arr">↗</span>
                </a>
              </>
            ))}
          </div>
          <button class="action action--press" type="button">
            <span>Press ({press.length})</span><span class="arr">▾</span>
          </button>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V6: minimal pill row below title */}
    <section class="variant">
      <h2 class="variant-title">V6 · Pill row beneath title</h2>
      <p class="variant-note">Small pills tucked between meta and note. Right column gone entirely. Reads tight; press disclosure mixes in as just another pill.</p>
      <article class="mock row-v6">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          <div class="pills">
            {links.map((l) => (
              <a class="pill" href={l.href}>
                <span>{l.label}</span><span class="arr">↗</span>
              </a>
            ))}
            <button class="pill pill--press" type="button">
              <span>Press</span><span class="pill-count">{press.length}</span><span class="arr">▾</span>
            </button>
          </div>
          {note && <p class="note">{note}</p>}
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V7: pills below note, press first (dashed) */}
    <section class="variant">
      <h2 class="variant-title">V7 · Pill row beneath note · press first (dashed)</h2>
      <p class="variant-note">Pills below the note. Press leads the row so the disclosure affordance is the first thing you scan. Dashed border on Press keeps it visually distinct from outbound links.</p>
      <article class="mock row-v7">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
          <div class="pills">
            <button class="pill pill--press" type="button">
              <span>Press</span><span class="pill-count">{press.length}</span><span class="arr">▾</span>
            </button>
            {links.map((l) => (
              <a class="pill" href={l.href}>
                <span>{l.label}</span><span class="arr">↗</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V7.1: press as plain text (no chrome) */}
    <section class="variant">
      <h2 class="variant-title">V7.1 · Press as plain text · press first</h2>
      <p class="variant-note">Press loses the pill chrome entirely — just label + count + ▾. Reads as a quiet disclosure cue rather than a peer of the outbound links, which keeps the navigation pills as the clear primary actions.</p>
      <article class="mock row-v7-1">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
          <div class="pills">
            <button class="press-plain" type="button">
              <span>Press</span><span class="pill-count">{press.length}</span><span class="arr">▾</span>
            </button>
            {links.map((l) => (
              <a class="pill" href={l.href}>
                <span>{l.label}</span><span class="arr">↗</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V7.2: press matches link pills, ▾ arrow */}
    <section class="variant">
      <h2 class="variant-title">V7.2 · Press matches link pills · press first</h2>
      <p class="variant-note">Press uses the exact same pill chrome as the outbound links (solid border, raised bg). Only the arrow differs — ▾ instead of ↗ — to signal "expands in place" vs. "navigates away."</p>
      <article class="mock row-v7-2">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
          <div class="pills">
            <button class="pill" type="button">
              <span>Press</span><span class="pill-count">{press.length}</span><span class="arr">▾</span>
            </button>
            {links.map((l) => (
              <a class="pill" href={l.href}>
                <span>{l.label}</span><span class="arr">↗</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V8: V7.2 but note runs full row width */}
    <section class="variant">
      <h2 class="variant-title">V8 · V7.2 with full-width note</h2>
      <p class="variant-note">Same chrome as V7.2 — press first, identical pill styling, ▾/↗ arrows. Note loses its 60ch reading cap so it spans the full body column, with the row's natural right padding (var(--s-5)) as the right margin.</p>
      <article class="mock row-v8">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
          <div class="pills">
            <button class="pill" type="button">
              <span>Press</span><span class="pill-count">{press.length}</span><span class="arr">▾</span>
            </button>
            {links.map((l) => (
              <a class="pill" href={l.href}>
                <span>{l.label}</span><span class="arr">↗</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V8.1: V7.2 chrome, note capped near title width */}
    <section class="variant">
      <h2 class="variant-title">V8.1 · V7.2 chrome, note capped at title width</h2>
      <p class="variant-note">Same chrome as V7.2/V8 — press first, identical pill styling, ▾/↗ arrows. Note caps at ~80ch (≈ visual width of a one-line title in Fraunces 22px). Wider than V7.2's 60ch reading cap, narrower than V8's full-width.</p>
      <article class="mock row-v8-1">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
          <div class="pills">
            <button class="pill" type="button">
              <span>Press</span><span class="pill-count">{press.length}</span><span class="arr">▾</span>
            </button>
            {links.map((l) => (
              <a class="pill" href={l.href}>
                <span>{l.label}</span><span class="arr">↗</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </section>

    {/* ——————————————————————————————————— V9: V8.1 with the press count visually highlighted */}
    <section class="variant">
      <h2 class="variant-title">V9 · V8.1 + highlighted press count</h2>
      <p class="variant-note">Same layout/chrome as V8.1. The press count now reads in the amber accent + medium weight — emphasises the volume of coverage at a glance without the rest of the pill changing.</p>
      <article class="mock row-v9">
        <div class="thumb"><img src={thumbSrc} alt={thumbAlt} loading="lazy"/></div>
        <div class="body">
          <h3 class="title" set:html={titleHtml}/>
          <p class="meta">
            {meta.map((p, i) => (
              <>
                {i > 0 && <span class="sep">·</span>}
                {p.kind === "smallcaps" ? <span class="smallcaps">{p.text}</span> : <span set:html={p.text}/>}
              </>
            ))}
          </p>
          {note && <p class="note">{note}</p>}
          <div class="pills">
            <button class="pill" type="button">
              <span>Press</span><span class="pill-count">{press.length}</span><span class="arr">▾</span>
            </button>
            {links.map((l) => (
              <a class="pill" href={l.href}>
                <span>{l.label}</span><span class="arr">↗</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    </section>
    </div></section>
  </main>
</BaseLayout>

<style>
  .mockup-main { color: var(--fg); }
  .mockup-header { margin-bottom: var(--s-7); }
  .mockup-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-faint);
    margin: 0 0 var(--s-3);
  }
  .mockup-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-variation-settings: "opsz" 96, "SOFT" 30;
    font-size: var(--t-h2);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--s-3);
  }
  .mockup-lede {
    font-size: var(--t-body);
    color: var(--fg-muted);
    max-width: 60ch;
    margin: 0;
  }

  .variant { margin-top: var(--s-8); }
  .variant-title {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg);
    margin: 0 0 var(--s-2);
  }
  .variant-note {
    font-size: var(--t-meta);
    color: var(--fg-muted);
    max-width: 70ch;
    margin: 0 0 var(--s-4);
  }

  /* —————————————————————— Shared row primitives (one source of truth) */
  .mock {
    position: relative;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--bg);
  }
  .mock .thumb {
    width: 88px;
    height: 88px;
    overflow: hidden;
    background: var(--bg-sunken);
  }
  .mock .thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .mock .title {
    font-family: var(--font-display);
    font-weight: 400;
    font-variation-settings: "opsz" 96, "SOFT" 30;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 4px;
    text-wrap: balance;
    color: var(--fg);
  }
  .mock .meta {
    font-size: var(--t-meta);
    color: var(--fg-muted);
    margin: 0 0 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: baseline;
  }
  .mock .meta .smallcaps {
    color: var(--fg);
    font-size: 16px;
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .mock .meta .sep { color: var(--fg-faint); }
  .mock .note {
    font-size: var(--t-meta);
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.55;
    max-width: 60ch;
  }

  /* ——————————————————————————————————— V0 baseline */
  .row-v0 {
    display: grid;
    grid-template-columns: 88px 1fr 140px;
    column-gap: var(--s-5);
    align-items: center;
    padding: var(--s-5);
  }
  .row-v0 .links {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
    text-align: right;
  }
  .row-v0 .links a {
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 1px;
  }
  .row-v0 .press-summary {
    grid-column: 3;
    grid-row: 1;
    align-self: end;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .row-v0 .press-summary .press-count { color: var(--fg-faint); }

  /* ——————————————————————————————————— V1 quiet stack + arrows */
  .row-v1 {
    display: grid;
    grid-template-columns: 88px 1fr 140px;
    column-gap: var(--s-5);
    align-items: center;
    padding: var(--s-5);
  }
  .row-v1 .actions {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--s-2);
  }
  .row-v1 .action {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    font-family: var(--font-mono);
