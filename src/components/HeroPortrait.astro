---
// Square 1:1 portrait slideshow shown at the top of the sidebar in place of a
// static profile photo. Forks the cross-fade pattern from HeroCarousel.astro.
// Frames are pre-cropped squares served from R2 via siteAssetUrl/siteAssetSrcset
// (path stem under site/me/square/, synced by scripts/photos/sync-site-assets.ts).

import { siteAssetUrl, siteAssetSrcset, THUMB_SIZES } from "~/lib/siteAssetUrl";

export interface PortraitFrame {
  /** R2 asset path stem, e.g. "me/square/lars_lucy3" (no size/ext). */
  path: string;
  alt: string;
  /** All-caps caption, e.g. "KITE · WAVES". Currently not rendered (see below);
      kept so the overlay can be restored without re-authoring copy. */
  caption: string;
}

interface Props {
  frames: PortraitFrame[];
}

const { frames } = Astro.props;

const dwell = 8;
const total = dwell * frames.length;

// Portrait renders at clamp(280px, 32vw, 380px); covers mobile full-width too.
const SIZES_ATTR = "(max-width: 1023px) 90vw, 380px";
---
<div class="hero-portrait" data-frame-count={frames.length}>
  {frames.map((f, i) => (
    <img
      class="frame"
      src={siteAssetUrl(f.path, "540")}
      srcset={siteAssetSrcset(f.path, THUMB_SIZES)}
      sizes={SIZES_ATTR}
      alt={f.alt}
      style={`animation-delay: ${i * dwell}s; animation-duration: ${total}s;`}
      loading={i === 0 ? "eager" : "lazy"}
      decoding="async"
    />
  ))}
  {/* Per-frame captions are kept in the data (PortraitFrame.caption) but not
      rendered for now — re-add the overlaid #portrait-cap div + cycling script
      to bring them back. */}
</div>
