---
interface Props {
  /** Section number + label, e.g. "01 · NOW" */
  marker: string;
  /** Heading text */
  title: string;
  /** Optional description shown on the right column */
  desc?: string;
}

const { marker, title, desc } = Astro.props;
---
<div class="section-head">
  <div>
    <div class="marker">{marker}</div>
    <h2>{title}</h2>
  </div>
  {desc && <p class="desc">{desc}</p>}
</div>
