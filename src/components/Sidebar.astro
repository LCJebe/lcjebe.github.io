---
import Chip from "./Chip.astro";
import ThemeToggle from "./ThemeToggle.astro";
import HeroPortrait, { type PortraitFrame } from "./HeroPortrait.astro";

export interface NavItem {
  href: string;
  label: string;
  /** Two-digit string like "01" */
  num: string;
}

export interface SocialLink {
  href: string;
  label: string;
  external?: boolean;
}

export interface CredentialChip {
  label: string;
  withDot?: boolean;
}

interface Props {
  name: string;
  role: { line1: string; line2: string; line3?: string; line4?: string };
  /** Cross-fading square slideshow shown in place of a static profile photo. */
  frames: PortraitFrame[];
  chips: CredentialChip[];
  navItems: NavItem[];
  socials: SocialLink[];
}

const { name, role, frames, chips, navItems, socials } = Astro.props;
---
<aside class="sidebar">
  <HeroPortrait frames={frames} />

  {/* Page-level <h1> lives in Hero (SEO/a11y prefers one prominent h1).
      Sidebar name is rendered as a <p> styled identically. */}
  <p class="name">{name}</p>
  <p class="role">
    {role.line1}<br />{role.line2}{role.line3 && <><br />{role.line3}</>}{role.line4 && <><br />{role.line4}</>}
  </p>

  <div class="credentials">
    {chips.map((c) => (
      <Chip withDot={c.withDot}>{c.label}</Chip>
    ))}
  </div>

  <nav aria-label="Sections">
    {navItems.map((item) => (
      <a href={item.href}>
        <span>{item.label}</span>
        <span class="num">{item.num}</span>
      </a>
    ))}
  </nav>

  <div class="socials">
    {socials.map((s) => (
      <a href={s.href}>{s.label}</a>
    ))}
  </div>

  <ThemeToggle />
</aside>
