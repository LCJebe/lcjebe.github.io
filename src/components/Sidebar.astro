---
import Chip from "./Chip.astro";
import HeroPortrait, { type PortraitFrame } from "./HeroPortrait.astro";

export interface NavItem {
  href: string;
  label: string;
  /** Two-digit string like "01" */
  num: string;
}

export interface SocialLink {
  href: string;
  label: string;
  external?: boolean;
}

export interface CredentialChip {
  label: string;
  withDot?: boolean;
}

interface Props {
  name: string;
  role: { lines: readonly string[] };
  /** Cross-fading square slideshow shown in place of a static profile photo. */
  frames: PortraitFrame[];
  chips: CredentialChip[];
  navItems: NavItem[];
  socials: SocialLink[];
}

const { name, role, frames, chips, navItems, socials } = Astro.props;
---
<aside class="sidebar">
  <HeroPortrait frames={frames} />

  {/* Page-level <h1> lives in Hero (SEO/a11y prefers one prominent h1).
      Sidebar name is rendered as a <p> styled identically. */}
  <p class="name">{name}</p>
  <p class="role">
    {role.lines.map((line) => <span class="line">{line}</span>)}
  </p>

  <div class="credentials">
    {chips.map((c) => (
      <Chip withDot={c.withDot}>{c.label}</Chip>
    ))}
  </div>

  {/* Hamburger toggle — visible on mobile only (CSS). On desktop the nav
      below is always shown and this button is hidden. */}
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="section-nav"
  >
    <span class="nav-toggle-bars" aria-hidden="true"></span>
    <span>Sections</span>
  </button>
  <nav id="section-nav" aria-label="Sections">
    {navItems.map((item) => (
      <a href={item.href}>
        <span>{item.label}</span>
        <span class="num">{item.num}</span>
      </a>
    ))}
  </nav>

  <div class="socials">
    {socials.map((s) => (
      <a href={s.href}>{s.label}</a>
    ))}
  </div>
</aside>

<script>
  // Mobile hamburger: flip aria-expanded; CSS reveals the adjacent <nav>.
  // Choosing a section collapses the menu again.
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.querySelector<HTMLElement>("#section-nav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
    });
    nav.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) {
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
