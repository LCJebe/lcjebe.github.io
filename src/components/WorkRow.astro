---
export interface MetaPart {
  /** "smallcaps" renders with all-small-caps treatment; "plain" is regular text */
  kind: "smallcaps" | "plain";
  text: string;
}

export interface WorkLink {
  href: string;
  label: string;
  external?: boolean;
}

export interface PressItem {
  href: string;
  venue: string;
  title: string;
  external?: boolean;
}

interface Props {
  /** Path or URL for the 88×88 thumbnail image */
  thumbSrc: string;
  thumbAlt: string;
  /**
   * Title can include a trailing accent like "— best paper candidate".
   * Pass HTML to allow inline <span class="smallcaps">.
   */
  titleHtml: string;
  /** Meta row parts; renders with " · " separators between parts */
  meta: MetaPart[];
  /** Optional descriptive note */
  note?: string;
  /** Pill row: external destinations rendered after the press disclosure */
  links?: WorkLink[];
  /** Optional press/media coverage; collapsible "Press (N)" pill at the front of the pill row. */
  press?: PressItem[];
  /** Visual highlight: subtle accent tint + left accent border. Reserved for
   *  pinning the current-role entry at the top of a list. */
  highlight?: boolean;
}

const { thumbSrc, thumbAlt, titleHtml, meta, note, links = [], press = [], highlight = false } = Astro.props;
---
<article class={`work-row${highlight ? " is-highlighted" : ""}`}>
  <div class="thumb">
    <img src={thumbSrc} alt={thumbAlt} loading="lazy" decoding="async" />
  </div>
  <div class="body">
    <h3 class="title" set:html={titleHtml} />
    <p class="meta">
      {meta.map((part, i) => (
        <>
          {i > 0 && <span class="sep">·</span>}
          {part.kind === "smallcaps" ? (
            <span class="smallcaps">{part.text}</span>
          ) : (
            <span set:html={part.text} />
          )}
        </>
      ))}
    </p>
    {note && <p class="note">{note}</p>}
    {(press.length > 0 || links.length > 0) && (
      <div class="pills">
        {press.length > 0 && (
          <button class="pill pill--press" type="button" aria-expanded="false">
            <span>Press</span>
            <span class="pill-count">{press.length}</span>
            <span class="arr" aria-hidden="true">▾</span>
          </button>
        )}
        {links.map((l) => (
          <a
            class="pill"
            href={l.href}
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener noreferrer" : undefined}
          >
            <span>{l.label}</span>
            <span class="arr" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    )}
  </div>
  {press.length > 0 && (
    <ul class="press-list">
      {press.map((p) => (
        <li>
          <span class="press-venue">{p.venue}</span>
          <span class="press-sep" aria-hidden="true">—</span>
          <a
            class="press-title"
            href={p.href}
            target={p.external ? "_blank" : undefined}
            rel={p.external ? "noopener noreferrer" : undefined}
          >{p.title}</a>
        </li>
      ))}
    </ul>
  )}
</article>

<script>
  // Whole-row click → navigate to the first link pill (skipping the press
  // button). Clicks on any pill, <a>, or the press-list propagate normally.
  // Press button toggles aria-expanded; CSS :has() reveals .press-list.
  document.querySelectorAll<HTMLElement>(".work-row").forEach((row) => {
    const firstLink = row.querySelector<HTMLAnchorElement>(".pills a.pill");
    if (firstLink) {
      row.addEventListener("click", (e) => {
        const target = e.target as Element | null;
        if (target?.closest("a")) return;
        if (target?.closest(".pill--press, .press-list")) return;
        firstLink.click();
      });
    }

    const pressBtn = row.querySelector<HTMLButtonElement>(".pill--press");
    if (pressBtn) {
      pressBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const expanded = pressBtn.getAttribute("aria-expanded") === "true";
        pressBtn.setAttribute("aria-expanded", expanded ? "false" : "true");
      });
    }
  });
</script>
