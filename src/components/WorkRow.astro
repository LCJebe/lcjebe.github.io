---
export interface MetaPart {
  /** "smallcaps" renders with all-small-caps treatment; "plain" is regular text */
  kind: "smallcaps" | "plain";
  text: string;
}

export interface WorkLink {
  href: string;
  label: string;
  external?: boolean;
}

export interface PressItem {
  href: string;
  venue: string;
  title: string;
  external?: boolean;
}

interface Props {
  /** Path or URL for the 88×88 thumbnail image */
  thumbSrc: string;
  thumbAlt: string;
  /**
   * Title can include a trailing accent like "— best paper candidate".
   * Pass HTML to allow inline <span class="smallcaps">.
   */
  titleHtml: string;
  /** Meta row parts; renders with " · " separators between parts */
  meta: MetaPart[];
  /** Optional descriptive note */
  note?: string;
  /** Right-column link list (mono, uppercase) */
  links?: WorkLink[];
  /** Optional press/media coverage; renders as a collapsible "Press" expander. */
  press?: PressItem[];
}

const { thumbSrc, thumbAlt, titleHtml, meta, note, links = [], press = [] } = Astro.props;
---
<article class="work-row">
  <div class="thumb">
    <img src={thumbSrc} alt={thumbAlt} loading="lazy" decoding="async" />
  </div>
  <div class="body">
    <h3 class="title" set:html={titleHtml} />
    <p class="meta">
      {meta.map((part, i) => (
        <>
          {i > 0 && <span class="sep">·</span>}
          {part.kind === "smallcaps" ? (
            <span class="smallcaps">{part.text}</span>
          ) : (
            <span set:html={part.text} />
          )}
        </>
      ))}
    </p>
    {note && <p class="note">{note}</p>}
  </div>
  {links.length > 0 && (
    <div class="links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
  )}
  {press.length > 0 && (
    <details class="press-expand">
      <summary>
        <span class="press-label">Press</span>
        <span class="press-count">({press.length})</span>
        <span class="chevron" aria-hidden="true">↓</span>
      </summary>
    </details>
  )}
  {press.length > 0 && (
    <ul class="press-list">
      {press.map((p) => (
        <li>
          <span class="press-venue">{p.venue}</span>
          <span class="press-sep" aria-hidden="true">—</span>
          <a
            class="press-title"
            href={p.href}
            target={p.external ? "_blank" : undefined}
            rel={p.external ? "noopener noreferrer" : undefined}
          >{p.title}</a>
        </li>
      ))}
    </ul>
  )}
</article>

<script>
  // Whole-row click → navigate to the first link in the row's links column.
  // Clicks on any inner <a>, <summary>, or inside the press expander propagate
  // normally and aren't intercepted.
  document.querySelectorAll<HTMLElement>(".work-row").forEach((row) => {
    const firstLink = row.querySelector<HTMLAnchorElement>(".links a");
    if (!firstLink) return;

    row.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      if (target?.closest("a")) return;
      if (target?.closest(".press-expand, .press-list")) return;
      firstLink.click();
    });
  });
</script>
