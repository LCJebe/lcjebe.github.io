---
/**
 * Granted-patents credential surfaced beneath the peer-review row at the
 * bottom of the Research section. One line per patent, linked to the
 * public patent record.
 */
import { patents } from "~/data/patents";

const { entries } = patents;
---
<div class="patents">
  <span class="patents__eyebrow">Patents</span>
  <ul class="patents__list">
    {entries.map((p) => (
      <li class="patents__item">
        <a class="patents__link" href={p.href} target="_blank" rel="noopener noreferrer">
          <span class="patents__num">{p.number}</span>
          <span class="patents__title">{p.title}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
