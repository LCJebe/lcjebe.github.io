---
import type { ArtPiece } from "~/data/artwork";
import { siteAssetUrl, siteAssetSrcset, LARGE_SIZES } from "~/lib/siteAssetUrl";

interface Props {
  pieces: ArtPiece[];
}

const { pieces } = Astro.props;
const showNav = pieces.length > 1;

// Artwork is full-bleed in the layout — use all 4 sizes incl. 2k.
// `sizes="100vw"` is a coarse but safe upper bound; the browser will still
// pick the smallest variant that satisfies the rendered width × DPR.
const ART_SIZES_ATTR = "(min-width: 1024px) 60vw, 100vw";
---
<div class="artwork-block">
  <div class="image-stack">
    {pieces.map((p, i) => (
      <div class:list={["art-img", { "is-active": i === 0 }]} data-index={i}>
        {p.kind === "collage" ? (
          <div class="art-collage">
            {p.images.map((img) => (
              <img
                src={siteAssetUrl(img.path, "1k")}
                srcset={siteAssetSrcset(img.path, LARGE_SIZES)}
                sizes={ART_SIZES_ATTR}
                alt={img.alt}
                width={img.width} height={img.height}
                loading="lazy" decoding="async"
              />
            ))}
          </div>
        ) : (
          <img
            src={siteAssetUrl(p.path, "1k")}
            srcset={siteAssetSrcset(p.path, LARGE_SIZES)}
            sizes={ART_SIZES_ATTR}
            alt={p.imageAlt}
            width={p.width} height={p.height}
            loading={i === 0 ? "eager" : "lazy"} decoding="async"
          />
        )}
      </div>
    ))}
  </div>

  <div class="copy-col">
    <div class="copy-stack">
      {pieces.map((p, i) => (
        <div class:list={["art-copy", { "is-active": i === 0 }]} data-index={i}>
          <h4>{p.title}</h4>
          {p.kind !== "collage" && p.makingOf && (
            <button
              type="button"
              class="art-makingof"
              data-src={siteAssetUrl(p.makingOf.path, "2k")}
              data-srcset={siteAssetSrcset(p.makingOf.path, LARGE_SIZES)}
              data-alt={p.makingOf.alt}
            >{p.makingOf.label}</button>
          )}
        </div>
      ))}
    </div>
    {showNav && (
      <div class="art-controls">
        <button type="button" class="art-prev" aria-label="Previous piece">←</button>
        <div class="art-dots" role="tablist" aria-label="Artwork indicator">
          {pieces.map((_, i) => (
            <button type="button"
              class:list={["art-dot", { "is-active": i === 0 }]}
              data-index={i}
              aria-label={`Show piece ${i + 1}`}
            />
          ))}
        </div>
        <button type="button" class="art-next" aria-label="Next piece">→</button>
      </div>
    )}
  </div>
</div>

<div class="art-lightbox" id="art-lightbox" role="dialog" aria-modal="true" aria-label="Making-of" hidden>
  <button type="button" class="art-lightbox-close" aria-label="Close">✕</button>
  <img class="art-lightbox-img" src="" alt="" sizes="90vw" />
</div>

<script>
  const block = document.querySelector<HTMLElement>(".artwork-block");
  if (block) {
    const imgs = Array.from(block.querySelectorAll<HTMLElement>(".art-img"));
    const copies = Array.from(block.querySelectorAll<HTMLElement>(".art-copy"));
    const dots = Array.from(block.querySelectorAll<HTMLElement>(".art-dot"));
    const N = imgs.length;
    let active = 0;

    const show = (next: number) => {
      const target = (next + N) % N;
      if (target === active) return;
      [imgs, copies, dots].forEach((group) => {
        group[active]?.classList.remove("is-active");
        group[target]?.classList.add("is-active");
      });
      active = target;
    };

    block.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest(".art-next")) return show(active + 1);
      if (t.closest(".art-prev")) return show(active - 1);
      const dot = t.closest<HTMLElement>(".art-dot");
      if (dot) {
        const idx = Number(dot.dataset.index);
        if (!Number.isNaN(idx)) show(idx);
      }
    });

    // —— Making-of lightbox ——
    const lb = document.querySelector<HTMLElement>("#art-lightbox");
    const lbImg = lb?.querySelector<HTMLImageElement>(".art-lightbox-img");
    if (lb && lbImg) {
      const close = () => {
        lb.hidden = true;
        lbImg.removeAttribute("srcset");
        lbImg.src = "";
        document.body.style.removeProperty("overflow");
      };

      block.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>(".art-makingof");
        if (!btn) return;
        const { src, srcset, alt } = btn.dataset;
        if (srcset) lbImg.srcset = srcset;
        lbImg.src = src ?? "";
        lbImg.alt = alt ?? "";
        lb.hidden = false;
        document.body.style.overflow = "hidden";
      });

      lb.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest(".art-lightbox-img")) return;
        close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !lb.hidden) close();
      });
    }
  }
</script>
