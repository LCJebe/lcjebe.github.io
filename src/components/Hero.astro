---
import Button from "./Button.astro";

interface Props {
  /** Tagline HTML — pass as raw string. Use <em>...</em> for the italic accent. */
  taglineHtml: string;
  /** Lead paragraphs — one <p class="sub"> per entry. Each supports inline HTML. */
  leadParagraphsHtml: string[];
  primaryCta: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}

const { taglineHtml, leadParagraphsHtml, primaryCta, secondaryCta } = Astro.props;
---
<section class="hero" id="hero">
  <div class="container hero-stack">
    <div class="eyebrow">
      <span
        class="term"
        data-phrases='["/build","/ship","/scale","/repeat"]'
        data-prompt="›"
        aria-label="build, ship, scale, repeat"
      ></span>
    </div>

    <h1 class="tagline" set:html={taglineHtml} />

    {leadParagraphsHtml.map((p) => (
      <p class="sub" set:html={p} />
    ))}

    <div class="hero-cta">
      <Button href={primaryCta.href} variant="primary">
        {primaryCta.label} <span aria-hidden="true">→</span>
      </Button>
      {secondaryCta && (
        <Button href={secondaryCta.href}>{secondaryCta.label}</Button>
      )}
      <span class="arrow" aria-hidden="true">↓ scroll</span>
    </div>
  </div>
</section>

<script>
  import { mountTerminals } from "~/scripts/term";
  mountTerminals();
</script>
