---
export interface Photo {
  /** Photo id (basename). Used as the data-id key so per-category repacking
   *  can map ordered-id lists back to DOM nodes. */
  id: string;
  /** URL for the masonry tile. */
  src: string;
  /** Alt text. */
  alt: string;
  /** Category memberships — used by the chip filter. A photo with multiple
   *  categories shows up under any of its chips. */
  categories: string[];
  /** Full-resolution URL opened in the PhotoSwipe lightbox. */
  fullSrc: string;
  /** Native pixel dimensions for layout + lightbox. Required — drives
   *  aspect-ratio reservation and prevents layout shift. */
  width: number;
  height: number;
}

export interface FilterDef {
  /** Either "all" (special) or a category id from portfolio.json. */
  id: string;
  label: string;
}

interface Props {
  filters: FilterDef[];
  photos: Photo[];
  /** Per-category ordered photo-id lists. Keyed by category id. The "all"
   *  filter is computed client-side from `photos` order. The client repacks
   *  the masonry against the selected filter's order on every filter change. */
  categoryOrders: Record<string, string[]>;
  /** Caption shown below the grid */
  footerHtml?: string;
}

import { packIntoColumns } from "~/lib/masonryPack";

const { filters, photos, categoryOrders, footerHtml } = Astro.props;

const SSR_COLS = 3;

// Build the orders payload consumed by the client. "all" is the photos array
// order; the rest comes from the loader's resolved per-category orders.
const orders: Record<string, string[]> = {
  all: photos.map((p) => p.id),
  ...categoryOrders,
};

// Filter active on first paint. We SSR this filter's pack into `.masonry` and
// the rest (hidden) into `.masonry-stash`, so JS users don't flash the full
// "all" grid before the client filters down on hydration. No-JS users see the
// default view's photos in the grid and the remainder below it.
const DEFAULT_FILTER = "landscape";
const byId = new Map(photos.map((p) => [p.id, p]));
const defaultIds = orders[DEFAULT_FILTER] ?? orders.all;
const defaultSet = new Set(defaultIds);
const defaultPhotos = defaultIds
  .map((id) => byId.get(id))
  .filter((p): p is Photo => Boolean(p));
const stashedPhotos = photos.filter((p) => !defaultSet.has(p.id));

// Server-render the desktop (3-column) pack of the default view. The client
// script repacks (and re-filters) in-place on filter changes and on narrower
// viewports using the same algorithm.
const packed = packIntoColumns(defaultPhotos, SSR_COLS);
---
<div class="gallery-toolbar">
  <div class="filter-row" role="tablist" aria-label="Photography filters">
    {filters.map((f) => (
      <button
        type="button"
        class="filter"
        data-filter={f.id}
        aria-pressed={f.id === DEFAULT_FILTER ? "true" : "false"}
      >{f.label}</button>
    ))}
  </div>

  {/* HDR badge. data-state is set at hydration from matchMedia and toggled
      if the display changes mid-session (e.g. plugging in an HDR monitor).
      SSR'd as "checking" (visually hidden) so no-JS users never see the
      wrong hint. */}
  <div class="hdr-badge-wrap" data-state="checking">
    <button
      type="button"
      class="hdr-badge"
      aria-label="HDR display status"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="hdr-popover"
    >
      <span class="hdr-glyph" aria-hidden="true">!!</span>
      <span class="hdr-label" aria-hidden="true">HDR</span>
      <span class="hdr-state-on" aria-hidden="true">· ON</span>
      <span class="hdr-dot" aria-hidden="true" />
      <span class="hdr-suggest" aria-hidden="true">VIEW IN HDR</span>
    </button>
    <div id="hdr-popover" class="hdr-popover" role="dialog" aria-label="About HDR" hidden>
      <p class="hdr-popover-on">
        Your display reports HDR. These photos render with their full dynamic range.
      </p>
      <p class="hdr-popover-suggest">
        These photos are HDR (gain-map JPEG). For the intended look, view on
        an HDR-capable display — recent MacBooks, iPhones, or modern OLED monitors.
      </p>
    </div>
  </div>
</div>

<div class="masonry" data-cols={SSR_COLS}>
  {packed.map((col) => (
    <div class="masonry-col">
      {col.map((p) => (
        <a
          class="masonry-item"
          data-id={p.id}
          href={p.fullSrc}
          data-pswp-width={p.width}
          data-pswp-height={p.height}
        >
          <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  ))}
</div>

{/* Hidden sibling for items filtered out by the active chip. Keeping them out
    of `.masonry` means PhotoSwipe's lightbox query (`.masonry .masonry-item`)
    naturally skips filtered items — no extra opt-out logic needed. SSR'd with
    every photo not in the default filter so the client can index all tiles. */}
<div class="masonry-stash" hidden>
  {stashedPhotos.map((p) => (
    <a
      class="masonry-item"
      data-id={p.id}
      href={p.fullSrc}
      data-pswp-width={p.width}
      data-pswp-height={p.height}
    >
      <img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
    </a>
  ))}
</div>

{/* Per-filter ordered id lists. Inlined as JSON so the client repack can read
    them without an extra fetch. Built server-side by loadPortfolio. */}
<script is:inline type="application/json" id="masonry-orders" set:html={JSON.stringify(orders)} />

{footerHtml && (
  <div class="gallery-footer" set:html={footerHtml} />
)}

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  // Unified filter + responsive repack. The server SSRs the "all" view in
  // 3 columns; the client repacks on hydration (matches on desktop, restacks
  // on narrower viewports) and on every filter chip click. Filtered-out
  // items move to .masonry-stash so PhotoSwipe's gallery selector skips them.
  //
  // Per-filter ordering comes from #masonry-orders (JSON, server-built).
  // Categories with an explicit `category_orders` entry use that order;
  // others fall back to the global order filtered to category members. Both
  // shapes are resolved in loadPortfolio — the client just consumes ids.
  (function () {
    const filterRow = document.querySelector<HTMLElement>(
      '[role="tablist"][aria-label="Photography filters"]',
    );
    const grid = document.querySelector<HTMLElement>(".masonry");
    const stash = document.querySelector<HTMLElement>(".masonry-stash");
    const ordersEl = document.querySelector<HTMLScriptElement>("#masonry-orders");
    if (!filterRow || !grid || !stash || !ordersEl) return;

    const orders: Record<string, string[]> = JSON.parse(ordersEl.textContent || "{}");

    // Index every tile once. Items live either in .masonry (visible) or in
    // .masonry-stash (filtered) — both are SSR'd, so scan both. The map
    // persists across repacks.
    const itemsById = new Map<string, HTMLAnchorElement>();
    for (const container of [grid, stash]) {
      for (const item of container.querySelectorAll<HTMLAnchorElement>(".masonry-item")) {
        const id = item.dataset.id;
        if (id) itemsById.set(id, item);
      }
    }

    function pickColCount(): number {
      if (window.innerWidth < 540) return 1;
      if (window.innerWidth < 900) return 2;
      return 3;
    }

    const pressed = filterRow.querySelector<HTMLButtonElement>('button[aria-pressed="true"]');
    let currentFilter = pressed?.dataset.filter ?? "all";
    let currentCols = Number(grid.dataset.cols ?? 0);

    function render(filter: string, nCols: number) {
      const ids = orders[filter] ?? [];
      const visible = new Set(ids);

      // Stash items not in the active filter. We move first so the grid is
      // free of stale nodes before we rebuild columns.
      for (const [id, el] of itemsById) {
        if (!visible.has(id) && el.parentElement !== stash) {
          stash!.appendChild(el);
        }
      }

      const colEls: HTMLDivElement[] = [];
      const heights: number[] = new Array(nCols).fill(0);
      const frag = document.createDocumentFragment();
      for (let i = 0; i < nCols; i++) {
        const col = document.createElement("div");
        col.className = "masonry-col";
        colEls.push(col);
        frag.appendChild(col);
      }

      for (const id of ids) {
        const item = itemsById.get(id);
        if (!item) continue;
        const w = Number(item.dataset.pswpWidth) || 1;
        const h = Number(item.dataset.pswpHeight) || 1;
        const ar = w > 0 ? h / w : 1;
        let minIdx = 0;
        for (let i = 1; i < nCols; i++) {
          if (heights[i] < heights[minIdx]) minIdx = i;
        }
        colEls[minIdx].appendChild(item);
        heights[minIdx] += ar;
      }

      grid!.replaceChildren(frag);
      grid!.dataset.cols = String(nCols);
      grid!.dataset.filter = filter;
      currentCols = nCols;
    }

    render(currentFilter, pickColCount());

    filterRow.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-filter]");
      if (!btn || !filterRow!.contains(btn)) return;
      const filter = btn.dataset.filter;
      if (!filter) return;
      filterRow!
        .querySelectorAll<HTMLButtonElement>("button[data-filter]")
        .forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));
      if (filter === currentFilter) return;
      currentFilter = filter;
      render(currentFilter, currentCols);
    });

    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        const next = pickColCount();
        if (next !== currentCols) render(currentFilter, next);
      }, 100);
    });
  })();

  // HDR badge — detect display capability and toggle the explanatory
  // popover. The wrap's data-state flips between "on" (display reports
  // HDR) and "suggest" (SDR display — show the "view on HDR for full
  // effect" hint). Photos are gain-map JPEGs that render correctly on
  // both, so this is purely an "awareness" UI — no source swap needed.
  (function () {
    const wrap = document.querySelector<HTMLElement>(".hdr-badge-wrap");
    const badge = wrap?.querySelector<HTMLButtonElement>(".hdr-badge");
    const popover = wrap?.querySelector<HTMLElement>(".hdr-popover");
    if (!wrap || !badge || !popover) return;

    // Older Safari only exposes `dynamic-range` since 13.1; on browsers
    // without support, `matches` is false and the badge stays in
    // "suggest" — a safe default that errs toward the prompt rather
    // than a confidently-wrong "your display is HDR" claim.
    const mql = window.matchMedia("(dynamic-range: high)");
    const setState = () => {
      wrap.dataset.state = mql.matches ? "on" : "suggest";
    };
    setState();
    // Some browsers fire change when an external HDR display is plugged
    // in or when the OS toggles HDR mode. addEventListener over
    // addListener — the latter is deprecated.
    mql.addEventListener?.("change", setState);

    const openPopover = () => {
      popover.hidden = false;
      badge.setAttribute("aria-expanded", "true");
    };
    const closePopover = () => {
      popover.hidden = true;
      badge.setAttribute("aria-expanded", "false");
    };
    const togglePopover = () => {
      if (popover.hidden) openPopover();
      else closePopover();
    };

    // Hover-to-open on desktop, with a small close delay so the cursor can
    // cross the gap into the popover without it disappearing. A pseudo-
    // element bridge inside .hdr-popover keeps the gap inside the wrap's
    // hover area, but the delay covers the brief gap on fast cursors.
    let closeTimer: number | undefined;
    const cancelClose = () => {
      if (closeTimer !== undefined) {
        window.clearTimeout(closeTimer);
        closeTimer = undefined;
      }
    };
    const scheduleClose = () => {
      cancelClose();
      closeTimer = window.setTimeout(closePopover, 120);
    };

    wrap.addEventListener("mouseenter", () => {
      cancelClose();
      openPopover();
    });
    wrap.addEventListener("mouseleave", scheduleClose);

    // Click stays as a fallback for touch devices (and keyboard activation).
    badge.addEventListener("click", (e) => {
      e.stopPropagation();
      cancelClose();
      togglePopover();
    });

    // Click outside / Esc to dismiss.
    document.addEventListener("click", (e) => {
      if (popover.hidden) return;
      if (wrap.contains(e.target as Node)) return;
      closePopover();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popover.hidden) {
        closePopover();
        badge.focus();
      }
    });
  })();

  // PhotoSwipe lightbox. Dimensions come from the JSON manifest and are set
  // directly on data-pswp-width/height — no lazy natural-size probe needed.
  (function () {
    const grid = document.querySelector<HTMLElement>(".masonry");
    if (!grid) return;

    const FILMSTRIP_HEIGHT = 96;
    const SLIDE_INSET = 48;
    // Matches the CSS --bp-mobile breakpoint (filmstrip hidden below it).
    const MOBILE_BP = 960;

    const lightbox = new PhotoSwipeLightbox({
      gallery: ".masonry",
      children: ".masonry-item",
      pswpModule: () => import("photoswipe"),
      bgOpacity: 1,
      showHideAnimationType: "fade",
      // No wraparound — first/last slide is a hard stop, matching the
      // filmstrip's non-looping behavior.
      loop: false,
      // Desktop reserves the bottom strip + side insets so the photo doesn't
      // touch the edges. On mobile the filmstrip is hidden (CSS) and we go
      // edge-to-edge so the photo fills the screen — PhotoSwipe's native
      // left/right swipe and swipe-down-to-close then do all the work.
      paddingFn: (viewportSize) =>
        viewportSize.x <= MOBILE_BP
          ? { top: 0, bottom: 0, left: 0, right: 0 }
          : {
              top: SLIDE_INSET,
              bottom: FILMSTRIP_HEIGHT + SLIDE_INSET,
              left: SLIDE_INSET,
              right: SLIDE_INSET,
            },
    });

    // Mobile: swap the lightbox source to the 1k derivative (~0.3 MB) instead
    // of the full-res HDR JPEG (~3 MB, ~9 MP). Several of the latter preloaded
    // at once OOM-crash and stall mobile browsers. The SSR'd data-pswp-width is
    // a generous 8000px placeholder (the manifest lacks true full dims), which
    // also gives PhotoSwipe wrong pan/zoom bounds and makes swipes feel stuck —
    // so we also set the real 1k dimensions (1024px long edge, same aspect).
    // Evaluated per-open, so desktop (full-res) is untouched.
    const LIGHTBOX_LONG_EDGE_1K = 1024;
    lightbox.addFilter("itemData", (itemData) => {
      if (window.innerWidth > MOBILE_BP) return itemData;
      const src =
        typeof itemData.src === "string"
          ? itemData.src.replace("/hdr_jpg_full/", "/hdr_jpg_1k/")
          : itemData.src;
      const long = Math.max(itemData.width || 0, itemData.height || 0) || 1;
      const scale = LIGHTBOX_LONG_EDGE_1K / long;
      return {
        ...itemData,
        src,
        width: Math.round((itemData.width || 0) * scale),
        height: Math.round((itemData.height || 0) * scale),
      };
    });

    // Custom UI: thumbnail filmstrip pinned to the bottom of the viewport,
    // active thumb scrolled to center, click-to-jump.
    lightbox.on("uiRegister", () => {
      lightbox.pswp!.ui!.registerElement({
        name: "filmstrip",
        appendTo: "root",
        onInit: (el, pswp) => {
          el.className = "pswp__filmstrip";
          const track = document.createElement("div");
          track.className = "pswp__filmstrip-track";
          el.appendChild(track);

          // Source from the same DOM nodes PhotoSwipe's gallery uses so
          // indices line up with pswp.currIndex / pswp.goTo(). Scope to
          // `.masonry` to exclude filtered items currently sitting in
          // `.masonry-stash`.
          const items = Array.from(
            document.querySelectorAll<HTMLAnchorElement>(".masonry .masonry-item"),
          );
          const thumbs = items.map((item, i) => {
            const tileImg = item.querySelector<HTMLImageElement>("img");
            const w = Number(item.dataset.pswpWidth) || 1;
            const h = Number(item.dataset.pswpHeight) || 1;
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "pswp__filmstrip-thumb";
            btn.style.aspectRatio = `${w} / ${h}`;
            btn.setAttribute("aria-label", `Photo ${i + 1} of ${items.length}`);
            const img = document.createElement("img");
            img.src = tileImg?.src ?? "";
            img.alt = "";
            img.loading = "lazy";
            img.decoding = "async";
            btn.appendChild(img);
            btn.addEventListener("click", () => pswp.goTo(i));
            track.appendChild(btn);
            return btn;
          });

          // A single navigation step scrolls smoothly, but rapid back-to-back
          // steps (holding the arrow key) fire `change` faster than a smooth
          // scroll can finish — each new scroll interrupts the last, so the
          // strip lags and then lurches to catch up. Jump instantly when steps
          // arrive in quick succession; animate only when there's a pause.
          let prevNav = 0;

          // Scroll-center the active thumb only when the thumbs overflow the
          // viewport; when they all fit, CSS centers the group and the strip
          // stays unscrolled.
          const syncOverflow = () => {
            track.classList.remove("is-overflow");
            if (el.scrollWidth > el.clientWidth) track.classList.add("is-overflow");
          };

          // `instant` forces a non-animated jump — used for the open/resize
          // calls so the strip isn't animating as the lightbox fades in.
          const setActive = (i: number, instant = false) => {
            thumbs.forEach((t, idx) => {
              const isActive = idx === i;
              t.classList.toggle("is-active", isActive);
              if (isActive) t.setAttribute("aria-current", "true");
              else t.removeAttribute("aria-current");
            });
            const active = thumbs[i];
            if (!active || !track.classList.contains("is-overflow")) return;
            const now = performance.now();
            const behavior: ScrollBehavior =
              instant || now - prevNav < 250 ? "auto" : "smooth";
            prevNav = now;
            const center = active.offsetLeft + active.offsetWidth / 2;
            el.scrollTo({ left: center - el.clientWidth / 2, behavior });
          };

          // PhotoSwipe appends this element to the DOM right after onInit
          // returns, so defer the first measurement a frame — until then the
          // strip is detached and reports zero width, hiding any overflow.
          requestAnimationFrame(() => {
            syncOverflow();
            setActive(pswp.currIndex, true);
          });
          pswp.on("change", () => setActive(pswp.currIndex));

          const onResize = () => {
            syncOverflow();
            setActive(pswp.currIndex, true);
          };
          window.addEventListener("resize", onResize);
          pswp.on("destroy", () => window.removeEventListener("resize", onResize));
        },
      });
    });

    lightbox.init();
  })();
</script>
